+def _piper_voice_for_text(text: str, piper_config: Dict[str, Any]) -> str | None:
+    """Choose a configured English/Spanish voice from the text itself.
+
+    This deliberately uses a tiny deterministic heuristic: installing a language model
+    just to route TTS would add latency and another runtime dependency. Ties keep the
+    configured default voice.
+    """
+    voices = piper_config.get("voices") or {}
+    if not isinstance(voices, dict):
+        return None
+    words = re.findall(r"[a-záéíóúüñ']+", text.lower())
+    es_words = {"a", "al", "como", "con", "de", "el", "en", "es", "esta", "este", "la", "las", "lo", "los", "para", "por", "que", "qué", "se", "si", "sí", "su", "te", "tu", "una", "y", "ya"}
+    en_words = {"a", "an", "and", "are", "as", "at", "be", "for", "from", "how", "i", "in", "is", "it", "of", "on", "that", "the", "this", "to", "what", "with", "you", "your"}
+    es_score = sum(word in es_words for word in words) + sum(ch in text.lower() for ch in "áéíóúüñ¿¡")
+    en_score = sum(word in en_words for word in words)
+    language = "en" if en_score > es_score else "es" if es_score > en_score else None
+    voice = voices.get(language) if language else None
+    return str(voice).strip() if voice else None
+
+
