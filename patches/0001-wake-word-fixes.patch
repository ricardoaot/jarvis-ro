+            if _config_section("voice").get("auto_tts", False):
+                self._voice_tts = True
+        if self._voice_tts:
+            self._tts_lease_async(True)  # calienta el motor TTS: si no, la 1a respuesta tarda
         self._voice_continuous = False
+        # PARCHE JARVIS: en macOS, abrir y cerrar el InputStream del wake word MATA
